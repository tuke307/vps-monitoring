        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "{container_name=~\"(api|web|email-worker)-.*\"} |~ \"(?i)(error|exception|fail|fatal)\"",
          "queryType": "range",
