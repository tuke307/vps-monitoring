{
  "uid": "vps-disk-fills-24h",
  "orgID": 1,
  "ruleGroup": "vps-host-health",
  "title": "Disk fills within 24h",
  "condition": "B",
  "data": [
    {
      "refId": "A",
      "queryType": "",
      "relativeTimeRange": { "from": 600, "to": 0 },
      "datasourceUid": "${DS_PROMETHEUS}",
      "model": {
        "expr": "predict_linear(node_filesystem_avail_bytes{job=\"node_exporter\",mountpoint=\"/\"}[1h], 24 * 3600)",
        "instant": true,
        "refId": "A",
        "hide": false
      }
    },
    {
      "refId": "B",
      "queryType": "",
      "relativeTimeRange": { "from": 0, "to": 0 },
      "datasourceUid": "-100",
      "model": {
        "type": "classic_conditions",
        "datasource": { "type": "__expr__", "uid": "-100" },
        "refId": "B",
        "hide": false,
        "conditions": [
          {
            "type": "query",
            "operator": { "type": "and" },
            "query": { "params": ["A"] },
            "reducer": { "type": "last", "params": [] },
            "evaluator": { "type": "lt", "params": [0] }
          }
        ]
      }
    }
  ],
  "noDataState": "NoData",
  "execErrState": "Error",
  "for": "5m",
  "annotations": {
    "summary": "Disk filling up on {{ $labels.instance }}",
    "description": "Linear extrapolation of the last hour predicts the root filesystem (/) on {{ $labels.instance }} will be full within 24h."
  },
  "labels": { "severity": "warning" },
  "isPaused": false
}
