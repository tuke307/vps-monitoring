{
  "uid": "vps-high-load",
  "orgID": 1,
  "ruleGroup": "vps-host-health",
  "title": "High load",
  "condition": "B",
  "data": [
    {
      "refId": "A",
      "queryType": "",
      "relativeTimeRange": { "from": 600, "to": 0 },
      "datasourceUid": "${DS_PROMETHEUS}",
      "model": {
        "expr": "node_load1{job=\"node_exporter\"}",
        "instant": true,
        "refId": "A",
        "hide": false
      }
    },
    {
      "refId": "B",
      "queryType": "",
      "relativeTimeRange": { "from": 0, "to": 0 },
      "datasourceUid": "-100",
      "model": {
        "type": "classic_conditions",
        "datasource": { "type": "__expr__", "uid": "-100" },
        "refId": "B",
        "hide": false,
        "conditions": [
          {
            "type": "query",
            "operator": { "type": "and" },
            "query": { "params": ["A"] },
            "reducer": { "type": "last", "params": [] },
            "evaluator": { "type": "gt", "params": [4] }
          }
        ]
      }
    }
  ],
  "noDataState": "NoData",
  "execErrState": "Error",
  "for": "5m",
  "annotations": {
    "summary": "High load on {{ $labels.instance }}",
    "description": "1-minute load average on {{ $labels.instance }} is above 4 for 5m. Tune the threshold to your CPU core count (nproc)."
  },
  "labels": { "severity": "warning" },
  "isPaused": false
}
